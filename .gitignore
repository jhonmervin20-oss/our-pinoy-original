# ---------------------------------------------------------------------------
# Secrets -- never commit these. config/database.php's hardcoded defaults are
# XAMPP's own out-of-the-box root/no-password local dev values, not a real
# secret, so that file IS tracked; only the actual .env is excluded.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Real database dumps and backups -- these contain live customer PII,
# employee payroll, and password hashes. Only database/migrations/ (DDL only)
# and database/seeds/ (holiday/discount seed data, no PII) are tracked.
# See reference_web_root_secret_exposure and reference_disk_full_file_truncation
# in project memory for why this data has leaked before.
# ---------------------------------------------------------------------------
database/*.sql
!database/restaurant_management_system_db_template.sql
database/backups/
# Two loose pre-change safety snapshots (real forecast/PO data) that live
# directly in database/ instead of database/backups/ -- same category, same
# reason to exclude.
database/_forecast_cleanup_backup_*.json
database/_po_subtotal_fix_backup_*.json

# ---------------------------------------------------------------------------
# Dependencies -- regenerated by `composer install` / `pip install -r
# requirements.txt` on the target host, not carried in git.
# ---------------------------------------------------------------------------
/vendor/
forecast_service/venv/
forecast_service/__pycache__/
**/__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Runtime-generated, not source -- caches, logs, uploaded files, forecast
# artifacts. Kept as empty directories via .gitkeep where the app expects
# the folder to exist on a fresh checkout. Each folder's own .htaccess
# (Require all denied -- keeps these directories un-downloadable over HTTP)
# is real security config, not runtime output, so it stays tracked too.
# ---------------------------------------------------------------------------
storage/cache/*
!storage/cache/.gitkeep
!storage/cache/.htaccess
storage/logs/*
!storage/logs/.gitkeep
!storage/logs/.htaccess
storage/baselines/*
!storage/baselines/.gitkeep
!storage/baselines/.htaccess
forecast_service/*.log
forecast_service/start_log.txt
forecast_service/.backtest_result.json

# ---------------------------------------------------------------------------
# Editor / AI-tool workspace state -- machine-local, not project source.
# ---------------------------------------------------------------------------
.claude/
.kilo/
.qodo/
.pytest_cache/
.vscode/
.idea/

# ---------------------------------------------------------------------------
# Ad-hoc debug scripts and their output, left at the project root during
# development -- not part of the application.
# ---------------------------------------------------------------------------
/check_tables.php
/check_feedback_cols.php
/php_out.txt
/tables_list.txt

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
Thumbs.db
.DS_Store
*.swp
*~
