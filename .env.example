# Copy to .env and fill in real values. Never commit the real .env.

# development shows PHP errors on the page; production logs them only.
# A real deploy's .env MUST set this to production.
APP_ENV=production

MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_PORT=587
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="OPO! - Our Pinoy Original"

OPENAI_API_KEY=

# --- Demand Forecast AI service (forecast_service/), deployed separately
# (e.g. Render -- see render.yaml at the repo root) ---
FORECAST_SERVICE_ENABLED=true
# The Render service's public URL, with the /forecast path Prophet client
# expects -- e.g. https://opo-forecast-service.onrender.com/forecast
FORECAST_SERVICE_URL=http://127.0.0.1:5000/forecast
# Must match the FORECAST_SERVICE_API_KEY set on the Render service once
# that URL is public -- otherwise anyone can call your forecasting service.
FORECAST_SERVICE_API_KEY=
# Only needed if the forecast host sleeps when idle (e.g. Render's free
# tier, ~30-50s cold start). Leave unset on an always-on host or local dev,
# where the tighter 3-8s defaults are correct. Applies to both the connect
# and total timeout.
FORECAST_SERVICE_TIMEOUT_SECONDS=
